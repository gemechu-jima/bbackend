DB_HOST=localhost
DB_PORT=3306
DB_NAME=bingo_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# If using PostgreSQL in production instead of MySQL, change to:
# DB_DIALECT=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false
