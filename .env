# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_bingo_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
# In development (NODE_ENV=development), SQLite is used automatically (database.sqlite file created locally, bypassing ports).
# In production (NODE_ENV=production), specify mysql or postgres below:
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bingo_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# If using PostgreSQL in production instead of MySQL, change to:
# DB_DIALECT=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# Public URL for static uploads (payment receipts)
